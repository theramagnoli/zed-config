{
    "theme": {
        "dark": "New Darcula Darker",
        "light": "macOS Classic Light",
        "mode": "light"
    },
    "icon_theme": {
        "dark": "Colored Zed Icons Theme Dark",
        "light": "Colored Zed Icons Theme Light",
        "mode": "light"
    },
    "ui_font_family": "Monaspace Radon Semiwide",
    "ui_font_size": 13.5,
    "ui_font_weight": 400.0,
    "buffer_font_family": "Monaspace Radon Semiwide",
    "buffer_font_features": {
        "calt": true,
        "clig": true,
        "liga": true
    },
    "buffer_font_size": 12.5,
    "buffer_font_weight": 400.0,
    "buffer_line_height": {
        "custom": 2
    },
    "agent_buffer_font_size": 12.5,
    "agent_ui_font_size": 13.5,
    "text_rendering_mode": "platform_default",
    "agent": {
        "auto_compact": {
            "threshold": "36%"
        },
        "commit_message_instructions": "Genera un único mensaje en español: Se + verbo en 3.ª persona + resultado concreto (40–90 chars, sin punto ni prefijos). Prioriza la intención, no archivos. Cuerpo opcional (máx. 4 viñetas) solo si hay varios cambios o una decisión no evidente. No inventes nada. Devuelve solo el mensaje.",
        "commit_message_model": {
            "effort": "low",
            "enable_thinking": false,
            "model": "go/deepseek-flash",
            "provider": "opencode"
        },
        "default_model": {
            "effort": "medium",
            "enable_thinking": true,
            "model": "grok-4.5",
            "provider": "x_ai_subscribed"
        },
        "dock": "right",
        "favorite_models": [
            {
                "effort": "medium",
                "enable_thinking": true,
                "model": "grok-4.5",
                "provider": "x_ai_subscribed"
            },
            {
                "effort": "high",
                "enable_thinking": true,
                "model": "go/deepseek-flash",
                "provider": "opencode"
            }
        ],
        "sandbox_permissions": {
            "allow_unsandboxed": true,
            "network_hosts": [
                "lucid.adonisjs.com",
                "html.duckduckgo.com",
                "www.google.com"
            ]
        },
        "subagent_model": {
            "effort": "high",
            "enable_thinking": true,
            "model": "go/deepseek-flash",
            "provider": "opencode"
        },
        "tool_permissions": {
            "default": "allow"
        }
    },
    "agent_servers": {
        "codex-acp": {
            "default_config_options": {
                "fast-mode": false,
                "mode": "agent-full-access",
                "model": "gpt-5.6-sol",
                "reasoning_effort": "medium"
            },
            "type": "registry"
        },
        "grok-build": {
            "type": "registry"
        },
        "opencode": {
            "default_config_options": {
                "model": "deepseek/deepseek-flash"
            },
            "type": "registry"
        }
    },
    "auto_install_extensions": {
        "catppuccin": true,
        "colored-zed-icons-theme": true,
        "darcula-dark-okkano": true,
        "dockerfile": true,
        "fleet-themes": true,
        "git-firefly": true,
        "html": true,
        "ibm-5151": true,
        "jetbrains-themes": true,
        "log": true,
        "macos-classic": true,
        "mcp-server-grafana": true,
        "new-darcula": true,
        "pylsp": true,
        "toml": true,
        "tsgo": true,
        "vue": true,
        "xml": true,
        "xy-zed": true,
        "zedokai": true
    },
    "centered_layout": {
        "left_padding": 0.165,
        "right_padding": 0
    },
    "collaboration_panel": {
        "button": false,
        "dock": "right"
    },
    "context_servers": {},
    "cursor_blink": true,
    "cursor_shape": "block",
    "debugger": {
        "button": true,
        "timeout": 10000
    },
    "diagnostics": {
        "inline": {
            "enabled": true,
            "min_column": 80
        }
    },
    "diff_view_style": "unified",
    "disable_ai": false,
    "edit_predictions": {
        "copilot": {
            "enable_next_edit_suggestions": false
        },
        "mode": "eager",
        "provider": "copilot"
    },
    "excerpt_context_lines": 6,
    "expand_excerpt_lines": 10,
    "file_finder": {
        "file_icons": true,
        "include_ignored": "indexed",
        "modal_max_width": "full"
    },
    "file_types": {
        "XML": [
            "wsdl",
            "xsd",
            "xaml"
        ]
    },
    "format_on_save": "on",
    "formatter": "prettier",
    "git": {
        "branch_picker": {
            "show_author_name": true
        }
    },
    "git_panel": {
        "dock": "right",
        "tree_view": false
    },
    "gutter": {
        "breakpoints": true,
        "folds": false,
        "line_numbers": true,
        "min_line_number_digits": 5,
        "runnables": false
    },
    "hard_tabs": false,
    "hide_mouse": "never",
    "indent_guides": {
        "active_line_width": 3,
        "background_coloring": "disabled",
        "coloring": "fixed",
        "enabled": true,
        "line_width": 1
    },
    "inlay_hints": {
        "enabled": false,
        "show_background": true,
        "show_type_hints": true
    },
    "language_models": {
        "opencode": {
            "show_free_models": false,
            "show_go_models": true,
            "show_zen_models": false
        }
    },
    "languages": {
        "CSS": {
            "language_servers": [
                "tailwindcss-language-server",
                "vscode-css-language-server"
            ],
            "prettier": {
                "allowed": true,
                "plugins": [
                    "@prettier/plugin-xml"
                ]
            }
        },
        "JavaScript": {
            "language_servers": [
                "typescript-ls",
                "!vtsls",
                "!typescript-language-server",
                "..."
            ]
        },
        "Markdown": {
            "show_edit_predictions": true
        },
        "Python": {
            "format_on_save": "on",
            "formatter": [
                {
                    "code_action": "source.organizeImports.ruff"
                },
                {
                    "code_action": "source.fixAll.ruff"
                },
                {
                    "language_server": {
                        "name": "ruff"
                    }
                }
            ],
            "language_servers": [
                "pylsp",
                "ruff",
                "!pyright",
                "..."
            ]
        },
        "TSX": {
            "language_servers": [
                "typescript-ls",
                "!vtsls",
                "!typescript-language-server",
                "..."
            ]
        },
        "TypeScript": {
            "language_servers": [
                "typescript-ls",
                "!vtsls",
                "!typescript-language-server",
                "..."
            ],
            "show_edit_predictions": true,
            "tab_size": 4
        },
        "Vue.js": {
            "language_servers": [
                "vue-language-server",
                "vtsls",
                "tailwindcss-language-server",
                "!typescript-language-server",
                "!typescript-ls"
            ]
        },
        "XML": {
            "prettier": {
                "allowed": true,
                "plugins": [
                    "@prettier/plugin-xml"
                ]
            }
        }
    },
    "lsp": {
        "pylsp": {
            "settings": {
                "plugins": {
                    "autopep8": {
                        "enabled": false
                    },
                    "black": {
                        "enabled": false
                    },
                    "flake8": {
                        "enabled": false
                    },
                    "isort": {
                        "enabled": false
                    },
                    "jedi": {
                        "enabled": true
                    },
                    "mccabe": {
                        "enabled": false
                    },
                    "pycodestyle": {
                        "enabled": false
                    },
                    "pydocstyle": {
                        "enabled": false
                    },
                    "pyflakes": {
                        "enabled": false
                    },
                    "pylint": {
                        "enabled": false
                    },
                    "pylsp_mypy": {
                        "enabled": true
                    },
                    "rope": {
                        "enabled": true
                    },
                    "rope_autoimport": {
                        "enabled": true
                    },
                    "rope_completion": {
                        "enabled": true
                    },
                    "ruff": {
                        "enabled": false
                    },
                    "yapf": {
                        "enabled": false
                    }
                }
            }
        },
        "ruff": {
            "initialization_options": {
                "settings": {
                    "codeAction": {
                        "disableRuleComment": {
                            "enable": false
                        },
                        "fixViolation": {
                            "enable": true
                        }
                    },
                    "configuration": {
                        "format": {
                            "quote-style": "double",
                            "skip-magic-trailing-comma": false
                        }
                    },
                    "configurationPreference": "filesystemFirst",
                    "fixAll": true,
                    "format": {
                        "preview": true
                    },
                    "lineLength": 100,
                    "lint": {
                        "enable": true,
                        "extendSelect": [
                            "I"
                        ],
                        "select": [
                            "E4",
                            "E7",
                            "E9",
                            "F"
                        ]
                    },
                    "organizeImports": true,
                    "showSyntaxErrors": true
                }
            }
        },
        "tailwindcss-language-server": {
            "settings": {
                "experimental": {
                    "classRegex": [
                        "class=\"([^\"]*)\"",
                        "class='([^']*)'",
                        ":class=\"([^\"]*)\"",
                        ":class='([^']*)'"
                    ]
                },
                "includeLanguages": {
                    "vue": "html"
                }
            }
        },
        "vscode-css-language-server": {
            "settings": {
                "css": {
                    "lint": {
                        "unknownAtRules": "ignore"
                    }
                }
            }
        },
        "vtsls": {
            "enable_lsp_tasks": true,
            "settings": {
                "javascript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always"
                    }
                },
                "typescript": {
                    "tsdk": "node_modules/typescript/lib",
                    "updateImportsOnFileMove": {
                        "enabled": "always"
                    }
                }
            }
        },
        "vue": {
            "initialization_options": {
                "typescript": {
                    "tsdk": "node_modules/typescript/lib"
                }
            }
        }
    },
    "max_tabs": 5,
    "minimum_contrast_for_highlights": 90.0,
    "outline_panel": {
        "dock": "right"
    },
    "preferred_line_length": 80,
    "preview_tabs": {
        "enable_preview_from_file_finder": false,
        "enabled": true
    },
    "project_panel": {
        "bold_folder_labels": true,
        "dock": "right",
        "entry_spacing": "standard",
        "hide_root": false,
        "indent_size": 30
    },
    "restore_on_startup": "last_workspace",
    "rounded_selection": true,
    "scrollbar": {
        "axes": {
            "horizontal": false
        },
        "diagnostics": "error",
        "selected_text": true
    },
    "show_edit_predictions": true,
    "tab_bar": {
        "show": true,
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": false
    },
    "tab_size": 4,
    "tabs": {
        "close_position": "right",
        "file_icons": false,
        "git_status": true,
        "show_diagnostics": "off"
    },
    "terminal": {
        "blinking": "on",
        "dock": "right",
        "line_height": "standard",
        "scrollbar": {
            "show": "never"
        },
        "toolbar": {
            "breadcrumbs": false
        }
    },
    "title_bar": {
        "show_menus": false,
        "show_user_menu": true,
        "show_user_picture": true
    },
    "toolbar": {
        "agent_review": true,
        "breadcrumbs": true,
        "code_actions": true,
        "quick_actions": false,
        "selections_menu": true
    },
    "unnecessary_code_fade": 0.3,
    "when_closing_with_no_tabs": "keep_window_open",
    "zoomed_padding": false
}
